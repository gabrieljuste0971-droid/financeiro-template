# Opcional. Sem estas duas variáveis o template guarda tudo no navegador
# (localStorage) e não precisa de backend nenhum.
#
# Para usar Supabase: rode supabase/schema.sql no seu projeto, copie este
# arquivo para .env e preencha. As duas chaves são públicas por natureza — a
# proteção real está na RLS do banco.
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=
